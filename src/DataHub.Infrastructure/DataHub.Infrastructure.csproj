<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Catalog persistence (Sqlite demo profile, SQL Server/Azure SQL production profiles), source connectors for SQL Server/MySQL/SQLite, Redis cache wiring, and the Blob Storage sync sink.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient arrives transitively (used by the SqlServer/AzureSql source executor). -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <!-- Redis production target, pinned per docs/architecture.md:
    <PackageReference Include="StackExchange.Redis" Version="2.9.32" />
    -->
    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
    <!-- Top-level pin: closes the transitive System.Security.Cryptography.Pkcs advisories. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- IHttpContextAccessor lives in the shared framework; the current-user
    adapter consumes it (ModernForms.Infrastructure pattern). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataHub.Domain\DataHub.Domain.csproj" />
    <ProjectReference Include="..\DataHub.Application\DataHub.Application.csproj" />
  </ItemGroup>

</Project>
