{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=datahub.db"
  },
  "Cache": {
    "Redis": {
      "ConnectionString": ""
    }
  },
  "Sync": {
    "IntervalSeconds": 900,
    "SchedulerEnabled": true,
    "FileSystemRoot": "var/sync",
    "Blob": {
      "Container": "datahub-sync",
      "ConnectionString": ""
    }
  },
  "Sources": {
    "Catalog": {
      "ConnectionString": "Data Source=datahub.db"
    },
    "MysqlRetail": {
      "ConnectionString": "Server=127.0.0.1;Port=3306;Database=datahub_retail;User ID=datahub_demo;Password=not-a-real-secret;DefaultCommandTimeout=20"
    },
    "AzureSqlFinance": {
      "ConnectionString": "Server=tcp:127.0.0.1,11433;Database=finance;User ID=demo_login;Password=not-a-real-secret;TrustServerCertificate=true"
    }
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Auth": {
    "Mode": "Development",
    "Development": {
      "Issuer": "datahub.dev",
      "Audience": "datahub.api",
      "TokenLifetimeMinutes": 120,
      "SigningKeyBase64": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWYwMTIzNDU2Nzg5YWJjZGVmMDEyMzQ1Njc4OWFiY2RlZg==",
      "Users": {
        "nadia": { "ExternalId": "nadia", "Roles": ["admin"] },
        "lucas": { "ExternalId": "lucas", "Roles": ["analyst"] },
        "sara": { "ExternalId": "sara", "Roles": ["viewer"] }
      }
    }
  }
}
